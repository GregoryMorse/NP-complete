/-- The last j-step of a B row: `Mr := M`, the hole is at the right end of the accumulator. -/
theorem jLast (Tl : List Nat) (ALr : List Nat) (Bpr : List Nat) (Fr : List Nat) (a : Nat) (v : Nat) (x : Nat) (hTl : Sym4 Tl) (hALr : Bits ALr) (hBpr : Bits Bpr) (hFr : Sym4 Fr) (ha : a = 1 ∨ a = 0) (hv : v ∈ bits) (hx : x ∈ bits) :
    zmmLogic.Reach (hdR QMM.J1 (Fr) (v :: (0 :: (Bpr ++ (a :: (x :: (0 :: (ALr ++ (1 :: (Tl))))))))))
      (hdR QMM.RS1 (Fr ++ (0 :: (v :: (Bpr ++ ([1]))))) (0 :: (jc a v x :: (ALr ++ (1 :: (Tl)))))) := by
  have hV : Valid [ALL, bits, bits, ALL] [Tl, ALr, Bpr, Fr] := Valid.cons hTl (Valid.cons hALr (Valid.cons hBpr (Valid.cons hFr (Valid.nil _))))
  rcases ha with rfl | rfl <;> rcases mem_bits hv with rfl | rfl <;> rcases mem_bits hx with rfl | rfl
  · exact checkFF (env := [Tl, ALr, Bpr, Fr]) (E := []) (k := 10) hV trivial
      (ls := [.blk 3 .id]) (rs := [.sym 2, .sym 0, .blk 2 .id, .sym 1, .sym 2, .sym 0, .blk 1 .id, .sym 1, .blk 0 .id])
      (ls' := [.blk 3 .id, .sym 0, .sym 2, .blk 2 .id, .sym 1]) (rs' := [.sym 0, .sym 2, .blk 1 .id, .sym 1, .blk 0 .id])
