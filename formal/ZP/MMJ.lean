/-- Rewind: the hole swaps with its neighbour. -/
theorem rsStep (Lq : List Nat) (R : List Nat) (x : Nat) (hLq : Sym4 Lq) (hR : Sym4 R) (hx : x ∈ bits) :
    zmmLogic.Reach (hdR QMM.RS1 (Lq) (0 :: (x :: (R))))
      (hdR QMM.RS1 (Lq ++ ([x])) (0 :: (R))) := by
  have hV : Valid [ALL, ALL] [Lq, R] := Valid.cons hLq (Valid.cons hR (Valid.nil _))
  rcases mem_bits hx with rfl | rfl
  · exact checkFF (env := [Lq, R]) (E := []) (k := 3) hV trivial
      (ls := [.blk 0 .id]) (rs := [.sym 0, .sym 2, .blk 1 .id])
      (ls' := [.blk 0 .id, .sym 2]) (rs' := [.sym 0, .blk 1 .id])
      (by decide +kernel) (by osimp) (by osimp) (by osimp) (by osimp)
  · exact checkFF (env := [Lq, R]) (E := []) (k := 3) hV trivial
      (ls := [.blk 0 .id]) (rs := [.sym 0, .sym 3, .blk 1 .id])
      (ls' := [.blk 0 .id, .sym 3]) (rs' := [.sym 0, .blk 1 .id])
      (by decide +kernel) (by osimp) (by osimp) (by osimp) (by osimp)



