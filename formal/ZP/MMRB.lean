module

public import ZP.MMPair

@[expose] public section

/-! Setup: the RB loop (generated by `scripts/mm/emit.py gr.py`). -/

namespace ZP.Mul.MM

open ZP

/-- RB loop step: bit `0` moves into the hole. -/
theorem rbStep0 (L : List Nat) (R : List Nat) (hL : Sym4 L) (hR : Sym4 R) :
    zmmLogic.Reach (hd QMM.RB1 (L ++ ([0])) (2 :: (R)))
      (hdR QMM.RB1 (L ++ ([2])) (0 :: (R))) := by
  have hV : Valid [ALL, ALL] [L, R] := Valid.cons hL (Valid.cons hR (Valid.nil _))
  exact checkTF (env := [L, R]) (E := []) (k := 3) hV trivial
    (ls := [.blk 0 .id, .sym 0]) (rs := [.sym 2, .blk 1 .id])
    (ls' := [.blk 0 .id, .sym 2]) (rs' := [.sym 0, .blk 1 .id])
    (by decide +kernel) (by osimp) (by osimp) (by osimp) (by osimp)


/-- RB loop step: bit `1` moves into the hole. -/
theorem rbStep1 (L : List Nat) (R : List Nat) (hL : Sym4 L) (hR : Sym4 R) :
    zmmLogic.Reach (hd QMM.RB1 (L ++ ([0])) (3 :: (R)))
      (hdR QMM.RB1 (L ++ ([3])) (0 :: (R))) := by
  have hV : Valid [ALL, ALL] [L, R] := Valid.cons hL (Valid.cons hR (Valid.nil _))
  exact checkTF (env := [L, R]) (E := []) (k := 3) hV trivial
    (ls := [.blk 0 .id, .sym 0]) (rs := [.sym 3, .blk 1 .id])
    (ls' := [.blk 0 .id, .sym 3]) (rs' := [.sym 0, .blk 1 .id])
    (by decide +kernel) (by osimp) (by osimp) (by osimp) (by osimp)


/-- RB loop exit: `M` is written into the hole, the head runs on to `RS1`. -/
theorem rbEnd (L : List Nat) (R : List Nat) (hL : Sym4 L) (hR : Sym4 R) :
    zmmLogic.Reach (hd QMM.RB1 (L ++ ([0])) (0 :: (1 :: (R))))
      (hdR QMM.RS1 (L ++ (1 :: (0 :: ([1])))) (R)) := by
  have hV : Valid [ALL, ALL] [L, R] := Valid.cons hL (Valid.cons hR (Valid.nil _))
  exact checkTF (env := [L, R]) (E := []) (k := 5) hV trivial
    (ls := [.blk 0 .id, .sym 0]) (rs := [.sym 0, .sym 1, .blk 1 .id])
    (ls' := [.blk 0 .id, .sym 1, .sym 0, .sym 1]) (rs' := [.blk 1 .id])
    (by decide +kernel) (by osimp) (by osimp) (by osimp) (by osimp)



end ZP.Mul.MM
