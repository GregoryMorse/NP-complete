/-- The beep: the marked flag, `M_2` and `s` are erased; `JINC` follows. -/
theorem ebEnd (Jx s R : List Nat) (hJx : Bits Jx) (hs : Bits s) (hR : Sym4 R) :
    zlpLogic.Reach (hd Q.EBs ([1] ++ Jx ++ [1] ++ s ++ [1, 2])
        (R))
      (hd Q.JINC ([1] ++ Jx)
        ([1] ++ List.replicate (s).length 0 ++ [0, 0] ++ R)) := by
  have hv : Valid [bits, bits, ALL] [Jx, s, R] := (Valid.cons hJx (Valid.cons hs (Valid.cons hR (Valid.nil _))))
  exact checkTT (env := [Jx, s, R]) (E := []) (k := 4) hv trivial
        (ls := [.sym 1, .blk 0 .id, .sym 1, .blk 1 .id, .sym 1, .sym 2]) (rs := [.blk 2 .id])
        (ls' := [.sym 1, .blk 0 .id]) (rs' := [.sym 1, .blk 1 (.const 0), .sym 0, .sym 0, .blk 2 .id])
        (by decide +kernel) (by simp [dR, Item.den, List.getD, map_id_app, map_const_rep, Fn.app, rep_rep, map_const_len]) (by simp [dR, Item.den, List.getD, map_id_app, map_const_rep, Fn.app, rep_rep, map_const_len]) (by simp [dR, Item.den, List.getD, map_id_app, map_const_rep, Fn.app, rep_rep, map_const_len]) (by simp [dR, Item.den, List.getD, map_id_app, map_const_rep, Fn.app, rep_rep, map_const_len])

