module

public import ZP.MMFetch2

@[expose] public section

/-! Fetch of the next `a` (B remains): FA, FB, FC, FD, FE, G2, J1.  Generated by `scripts/mm/gen_fetch3.py`.

Ascending layout at `FA`: `F0 = Au ++ replicate (q+1) 1 ++ Brem` (A not yet consumed, `q` consumed
entries, the boundary `M`, the rest `Brem` of B), the head on the last cell of `Brem`. -/

namespace ZP.Mul.MM

open ZP

theorem sym4_app_iff {u v : List Nat} : Sym4 (u ++ v) <-> Sym4 u /\ Sym4 v :=
  ⟨fun h => ⟨fun a ha => h a (List.mem_append_left _ ha), fun a ha => h a (List.mem_append_right _ ha)⟩,
    fun h => Sym4.app h.1 h.2⟩

theorem sym4_cons_iff {a : Nat} {v : List Nat} : Sym4 (a :: v) <-> a ∈ ALL /\ Sym4 v :=
  ⟨fun h => ⟨h a (by simp), fun b hb => h b (by simp [hb])⟩, fun h => Sym4.cons h.1 h.2⟩

@[simp] theorem sym4_nil_simp : Sym4 [] := Sym4.nil

theorem sym4_rep (q c : Nat) (h : c ∈ ALL) : Sym4 (List.replicate q c) := Sym4.rep q c h

theorem fbLoop (X : List Nat) (hX : Bits X) (L R : List Nat) (hL : Sym4 L) (hR : Sym4 R) :
    zmmLogic.Reach (hd Q.FB (L ++ X) R) (hd Q.FB L (X ++ R)) :=
  fLoop Q.FB (fun c => c = 2 ∨ c = 3)
    (fun c hc => by rcases hc with rfl | rfl <;> simp [ALL])
    (fun L R c hL hR hc => by
      rcases hc with rfl | rfl
      · exact fbStep2 L R hL hR
      · exact fbStep3 L R hL hR)
    X (fun a ha => by rcases mem_bits (hX a ha) with rfl | rfl <;> simp) L R hL hR

theorem fcLoop (q : Nat) (L R : List Nat) (hL : Sym4 L) (hR : Sym4 R) :
    zmmLogic.Reach (hd QMM.FC (L ++ List.replicate q 1) R) (hd QMM.FC L (List.replicate q 1 ++ R)) :=
  fLoop QMM.FC (fun c => c = 1)
    (fun c hc => by subst hc; simp [ALL])
    (fun L R c hL hR hc => by subst hc; exact fcM L R hL hR)
    _ (fun a ha => List.eq_of_mem_replicate ha) L R hL hR


theorem fetchA0 (Au' Br Bd X R0 : List Nat) (b q : Nat) (hAu : Bits Au') (hBr : Bits Br) (hb : b ∈ bits)
    (hBd : Bits Bd) (hX : Bits X) (hR : Sym4 R0) :
    zmmLogic.Reach
      (hd QMM.FA (Au' ++ 2 :: (List.replicate q 1 ++ 1 :: (Br ++ [b]))) (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0))
      (hd QMM.J1 (Au' ++ 1 :: (List.replicate q 1 ++ 1 :: (Br ++ [b]))) (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0)) := by
  have hAu4 := hAu.sym4
  have hBr4 := hBr.sym4
  have hBd4 := hBd.sym4
  have hX4 := hX.sym4
  have hb4 : b ∈ ALL := by rcases mem_bits hb with rfl | rfl <;> simp [ALL]
  have h0 : (0 : Nat) ∈ ALL := by simp [ALL]
  have h1 : (1 : Nat) ∈ ALL := by simp [ALL]
  have hx : (2 : Nat) ∈ ALL := by simp [ALL]
  have hw : (1 : Nat) ∈ ALL := by simp [ALL]
  have hrep := sym4_rep q 1 h1
  have e0 : Au' ++ 2 :: (List.replicate q 1 ++ 1 :: (Br ++ [b])) =
      (Au' ++ 2 :: (List.replicate q 1 ++ 1 :: Br)) ++ [b] := by simp
  rw [e0]
  -- FA reads the last bit of B
  have s0 : zmmLogic.Reach (hd QMM.FA ((Au' ++ 2 :: (List.replicate q 1 ++ 1 :: Br)) ++ [b])
        (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0))
      (hd Q.FB (Au' ++ 2 :: (List.replicate q 1 ++ 1 :: Br)) (b :: (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0))) := by
    have hL : Sym4 (Au' ++ 2 :: (List.replicate q 1 ++ 1 :: Br)) := by
      simp [sym4_app_iff, sym4_cons_iff, *]
    have hR' : Sym4 (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0) := by
      simp [sym4_app_iff, sym4_cons_iff, *]
    rcases mem_bits hb with rfl | rfl
    · exact faBit2 _ _ hL hR'
    · exact faBit3 _ _ hL hR'
  -- FB passes the rest of B
  have s1 := fbLoop Br hBr (Au' ++ 2 :: (List.replicate q 1 ++ [1])) (b :: (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0))
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FB meets the boundary
  have s2 := fbM (Au' ++ 2 :: List.replicate q 1) (Br ++ b :: (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0))
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FC passes the consumed entries
  have s3 := fcLoop q (Au' ++ [2]) (1 :: (Br ++ b :: (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0)))
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FC reads `a`
  have s4 := fcZ Au' (List.replicate q 1 ++ 1 :: (Br ++ b :: (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0)))
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FD runs back to P
  have s5 := kLoop QMM.FD0 (fun c => c = 1 ∨ c = 2 ∨ c = 3) (fun c hc => by rcases hc with rfl | rfl | rfl <;> simp [ALL])
    (fun L R c hL hR hc => by
      rcases hc with rfl | rfl | rfl
      · exact fd0Step1 L R hL hR
      · exact fd0Step2 L R hL hR
      · exact fd0Step3 L R hL hR)
    (List.replicate q 1 ++ 1 :: (Br ++ [b])) (by
      intro a ha
      simp only [List.mem_append, List.mem_replicate, List.mem_cons, List.mem_singleton] at ha
      rcases ha with ⟨_, rfl⟩ | rfl | ha | rfl | ha
      · simp
      · simp
      · rcases mem_bits (hBr a ha) with rfl | rfl <;> simp
      · rcases mem_bits hb with rfl | rfl <;> simp
      · exact absurd ha (by simp))
    (Au' ++ [1]) (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0)
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FD meets P
  have s6 := fd0End (Au' ++ 1 :: (List.replicate q 1 ++ 1 :: (Br ++ [b]))) (Bd ++ 1 :: X ++ 0 :: 1 :: R0)
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FE passes the done part of B
  have s7 := kLoop QMM.FE0 (fun c => c = 2 ∨ c = 3) (fun c hc => by rcases hc with rfl | rfl <;> simp [ALL])
    (fun L R c hL hR hc => by
      rcases hc with rfl | rfl
      · exact fe0Step2 L R hL hR
      · exact fe0Step3 L R hL hR)
    Bd (fun a ha => by rcases mem_bits (hBd a ha) with rfl | rfl <;> simp)
    (Au' ++ 1 :: (List.replicate q 1 ++ 1 :: (Br ++ [b])) ++ [0]) (1 :: X ++ 0 :: 1 :: R0)
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FE writes Mr := a
  have s8 := fe0End1 (Au' ++ 1 :: (List.replicate q 1 ++ 1 :: (Br ++ [b])) ++ [0] ++ Bd) (X ++ 0 :: 1 :: R0)
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- G2 back through B to P, then J1
  have s9 := g2Loop Bd hBd (Au' ++ 1 :: (List.replicate q 1 ++ 1 :: (Br ++ [b])) ++ [0]) (1 :: (X ++ 0 :: 1 :: R0))
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  have s10 := g2End (Au' ++ 1 :: (List.replicate q 1 ++ 1 :: (Br ++ [b]))) (Bd ++ 1 :: (X ++ 0 :: 1 :: R0))
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  rw [hd_snoc] at s6 s8
  simp only [List.append_assoc, List.cons_append, List.nil_append, List.singleton_append] at s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 ⊢
  exact s0.trans (s1.trans (s2.trans (s3.trans (s4.trans (s5.trans (s6.trans (s7.trans (s8.trans (s9.trans s10)))))))))

theorem fetchA1 (Au' Br Bd X R0 : List Nat) (b q : Nat) (hAu : Bits Au') (hBr : Bits Br) (hb : b ∈ bits)
    (hBd : Bits Bd) (hX : Bits X) (hR : Sym4 R0) :
    zmmLogic.Reach
      (hd QMM.FA (Au' ++ 3 :: (List.replicate q 1 ++ 1 :: (Br ++ [b]))) (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0))
      (hd QMM.J1 (Au' ++ 1 :: (List.replicate q 1 ++ 1 :: (Br ++ [b]))) (0 :: Bd ++ 0 :: X ++ 0 :: 1 :: R0)) := by
  have hAu4 := hAu.sym4
  have hBr4 := hBr.sym4
  have hBd4 := hBd.sym4
  have hX4 := hX.sym4
  have hb4 : b ∈ ALL := by rcases mem_bits hb with rfl | rfl <;> simp [ALL]
  have h0 : (0 : Nat) ∈ ALL := by simp [ALL]
  have h1 : (1 : Nat) ∈ ALL := by simp [ALL]
  have hx : (3 : Nat) ∈ ALL := by simp [ALL]
  have hw : (0 : Nat) ∈ ALL := by simp [ALL]
  have hrep := sym4_rep q 1 h1
  have e0 : Au' ++ 3 :: (List.replicate q 1 ++ 1 :: (Br ++ [b])) =
      (Au' ++ 3 :: (List.replicate q 1 ++ 1 :: Br)) ++ [b] := by simp
  rw [e0]
  -- FA reads the last bit of B
  have s0 : zmmLogic.Reach (hd QMM.FA ((Au' ++ 3 :: (List.replicate q 1 ++ 1 :: Br)) ++ [b])
        (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0))
      (hd Q.FB (Au' ++ 3 :: (List.replicate q 1 ++ 1 :: Br)) (b :: (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0))) := by
    have hL : Sym4 (Au' ++ 3 :: (List.replicate q 1 ++ 1 :: Br)) := by
      simp [sym4_app_iff, sym4_cons_iff, *]
    have hR' : Sym4 (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0) := by
      simp [sym4_app_iff, sym4_cons_iff, *]
    rcases mem_bits hb with rfl | rfl
    · exact faBit2 _ _ hL hR'
    · exact faBit3 _ _ hL hR'
  -- FB passes the rest of B
  have s1 := fbLoop Br hBr (Au' ++ 3 :: (List.replicate q 1 ++ [1])) (b :: (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0))
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FB meets the boundary
  have s2 := fbM (Au' ++ 3 :: List.replicate q 1) (Br ++ b :: (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0))
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FC passes the consumed entries
  have s3 := fcLoop q (Au' ++ [3]) (1 :: (Br ++ b :: (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0)))
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FC reads `a`
  have s4 := fcO Au' (List.replicate q 1 ++ 1 :: (Br ++ b :: (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0)))
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FD runs back to P
  have s5 := kLoop QMM.FD1 (fun c => c = 1 ∨ c = 2 ∨ c = 3) (fun c hc => by rcases hc with rfl | rfl | rfl <;> simp [ALL])
    (fun L R c hL hR hc => by
      rcases hc with rfl | rfl | rfl
      · exact fd1Step1 L R hL hR
      · exact fd1Step2 L R hL hR
      · exact fd1Step3 L R hL hR)
    (List.replicate q 1 ++ 1 :: (Br ++ [b])) (by
      intro a ha
      simp only [List.mem_append, List.mem_replicate, List.mem_cons, List.mem_singleton] at ha
      rcases ha with ⟨_, rfl⟩ | rfl | ha | rfl | ha
      · simp
      · simp
      · rcases mem_bits (hBr a ha) with rfl | rfl <;> simp
      · rcases mem_bits hb with rfl | rfl <;> simp
      · exact absurd ha (by simp))
    (Au' ++ [1]) (0 :: Bd ++ 1 :: X ++ 0 :: 1 :: R0)
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FD meets P
  have s6 := fd1End (Au' ++ 1 :: (List.replicate q 1 ++ 1 :: (Br ++ [b]))) (Bd ++ 1 :: X ++ 0 :: 1 :: R0)
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FE passes the done part of B
  have s7 := kLoop QMM.FE1 (fun c => c = 2 ∨ c = 3) (fun c hc => by rcases hc with rfl | rfl <;> simp [ALL])
    (fun L R c hL hR hc => by
      rcases hc with rfl | rfl
      · exact fe1Step2 L R hL hR
      · exact fe1Step3 L R hL hR)
    Bd (fun a ha => by rcases mem_bits (hBd a ha) with rfl | rfl <;> simp)
    (Au' ++ 1 :: (List.replicate q 1 ++ 1 :: (Br ++ [b])) ++ [0]) (1 :: X ++ 0 :: 1 :: R0)
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- FE writes Mr := a
  have s8 := fe1End1 (Au' ++ 1 :: (List.replicate q 1 ++ 1 :: (Br ++ [b])) ++ [0] ++ Bd) (X ++ 0 :: 1 :: R0)
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  -- G2 back through B to P, then J1
  have s9 := g2Loop Bd hBd (Au' ++ 1 :: (List.replicate q 1 ++ 1 :: (Br ++ [b])) ++ [0]) (0 :: (X ++ 0 :: 1 :: R0))
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  have s10 := g2End (Au' ++ 1 :: (List.replicate q 1 ++ 1 :: (Br ++ [b]))) (Bd ++ 0 :: (X ++ 0 :: 1 :: R0))
    (by simp [sym4_app_iff, sym4_cons_iff, *]) (by simp [sym4_app_iff, sym4_cons_iff, *])
  rw [hd_snoc] at s6 s8
  simp only [List.append_assoc, List.cons_append, List.nil_append, List.singleton_append] at s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 ⊢
  exact s0.trans (s1.trans (s2.trans (s3.trans (s4.trans (s5.trans (s6.trans (s7.trans (s8.trans (s9.trans s10)))))))))

end ZP.Mul.MM
