    zmmLogic.Reach (hd QMM.SM (L ++ ([2])) (R))
      (hd QMM.SM0 (L) (1 :: (R))) := by
  have hV : Valid [ALL, ALL] [L, R] := Valid.cons hL (Valid.cons hR (Valid.nil _))
