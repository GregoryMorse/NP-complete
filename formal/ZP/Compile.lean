module

public import ZP.Defs
public import ZP.Table
public import ZP.Abstract
public import ZP.Bridge
public import ZP.LTM
public import ZP.Logic
public import ZP.Logical

@[expose] public section

/-!
# The table simulates the logical machine (layer N1 + N2, proved)

`native/final.py` builds the 278-state table from the 4-symbol logical machine
`zpLogic` by storing logical cell `i` in table cells `2i, 2i+1` (pair encoding
`s ↦ (s / 2, s % 2)`) and then merging states. Every logical transition becomes a
*gadget*: a run of at most 5 table steps from the table state `cEntry q`, with the
head on cell `side q` of the pair, to `cEntry q'` on the next pair.

This file proves that once and for all:

* `wRun_sound`: a run on a 6-cell window (`WC`) that never leaves the window is a run
  of the machine on any tape that agrees with the window;
* `chk0` … `chk4`: every gadget, for every symbol and every value of the four
  neighbouring cells, reaches the right state, head and window and does not pass
  through the beep state (kernel evaluation, `decide +kernel`);
* `macroSim_of_logic`: a macro simulation of the abstract program by `zpLogic`
  gives one by `zpMachine`.

The certificate (`cEntry`, `cSide`, `cGlen`) is generated by `formal/gen_logic.py`
into `ZP/Logic.lean`; nothing about it is trusted, it is only evaluated.
-/

namespace ZP

/-! ## Runs of host machines -/

/-- `k` steps from `c` (step first). -/
def TM.exec (M : TM) : Nat → Conf → Option Conf
  | 0, c => some c
  | k + 1, c => (M.step c).bind (M.exec k)

theorem TM.exec_succ_last (M : TM) (k : Nat) (c : Conf) :
    M.exec (k + 1) c = (M.exec k c).bind M.step := by
  induction k generalizing c with
  | zero =>
    show (M.step c).bind (M.exec 0) = M.step c
    cases M.step c <;> rfl
  | succ k ih =>
    show (M.step c).bind (M.exec (k + 1)) = ((M.step c).bind (M.exec k)).bind M.step
    cases M.step c with
    | none => rfl
    | some d => exact ih d

theorem TM.conf_add (M : TM) (a b : Nat) : M.conf (a + b) = (M.conf a).bind (M.exec b) := by
  induction b with
  | zero =>
    show M.conf a = (M.conf a).bind (M.exec 0)
    cases M.conf a <;> rfl
  | succ b ih =>
    show (M.conf (a + b)).bind M.step = (M.conf a).bind (M.exec (b + 1))
    rw [ih]
    cases M.conf a with
    | none => rfl
    | some c => exact (TM.exec_succ_last M b c).symm

/-- What one step does in state `q` reading `b`: next state, written bit, direction. -/
def TM.act (M : TM) (q : Nat) (b : Bool) : Option (Nat × Nat × Nat) :=
  match M.table[q]? with
  | none => none
  | some (c0, c1) =>
    let code := if b then c1 else c0
    if code = 0 then none else some ((code - 1) / 4, (code - 1) % 2, (code - 1) / 2 % 2)

theorem TM.step_eq (M : TM) (c : Conf) :
    M.step c = (M.act c.q (c.tape c.head)).map (fun a =>
      ({ q := a.1, tape := fun i => if i = c.head then decide (a.2.1 = 1) else c.tape i,
         head := if a.2.2 = 1 then c.head + 1 else c.head - 1 } : Conf)) := by
  unfold TM.step TM.act
  cases M.table[c.q]? with
  | none => rfl
  | some p =>
    obtain ⟨c0, c1⟩ := p
    dsimp only
    by_cases hc : (if c.tape c.head = true then c1 else c0) = 0
    · rw [if_pos hc, if_pos hc] <;> rfl
    · rw [if_neg hc, if_neg hc] <;> rfl

/-! ## Window runs -/

/-- A configuration on a window of six cells `0 … 5`. -/
structure WC where
  st  : Nat
  pos : Int
  win : Int → Bool

/-- One step on the window; `none` if the machine halts or the head leaves the window. -/
def wStep (M : TM) (s : WC) : Option WC :=
  match M.act s.st (s.win s.pos) with
  | none => none
  | some (q, w, r) =>
    if 0 ≤ (if r = 1 then s.pos + 1 else s.pos - 1) ∧
        (if r = 1 then s.pos + 1 else s.pos - 1) < 6 then
      some ⟨q, if r = 1 then s.pos + 1 else s.pos - 1,
        fun o => if o = s.pos then decide (w = 1) else s.win o⟩
    else none

/-- `k` window steps; `none` also if a state strictly inside the run is the beep state. -/
def wRun (M : TM) : Nat → WC → Option WC
  | 0, s => some s
  | k + 1, s =>
    match wStep M s with
    | none => none
    | some s1 => if k = 0 then some s1 else if s1.st = M.beep then none else wRun M k s1

/-- The tape `T0` with the window placed at `base`. -/
def winTape (base : Int) (T0 : Int → Bool) (w : Int → Bool) (j : Int) : Bool :=
  if base ≤ j ∧ j < base + 6 then w (j - base) else T0 j

theorem winTape_in {base j : Int} {T0 w : Int → Bool} (h1 : base ≤ j) (h2 : j < base + 6) :
    winTape base T0 w j = w (j - base) := by
  unfold winTape
  rw [if_pos ⟨h1, h2⟩]

theorem winTape_out {base j : Int} {T0 w : Int → Bool} (h : ¬ (base ≤ j ∧ j < base + 6)) :
    winTape base T0 w j = T0 j := by
  unfold winTape
  rw [if_neg h]

/-- A host configuration agrees with a window configuration placed at `base`. -/
structure WRel (base : Int) (T0 : Int → Bool) (c : Conf) (s : WC) : Prop where
  q : c.q = s.st
  head : c.head = base + s.pos
  lo : 0 ≤ s.pos
  hi : s.pos < 6
  tape : ∀ j, c.tape j = winTape base T0 s.win j

theorem wStep_sound {M : TM} {base : Int} {T0 : Int → Bool} {c : Conf} {s s' : WC}
    (h : WRel base T0 c s) (hs : wStep M s = some s') :
    ∃ c', M.step c = some c' ∧ WRel base T0 c' s' := by
  obtain ⟨hq, hh, hp0, hp6, ht⟩ := h
  have hread : c.tape c.head = s.win s.pos := by
    rw [ht c.head, winTape_in (by omega) (by omega), show c.head - base = s.pos by omega]
  rw [TM.step_eq, hq, hread]
  unfold wStep at hs
  cases ha : M.act s.st (s.win s.pos) with
  | none =>
    rw [ha] at hs
    have h' : (none : Option WC) = some s' := hs
    cases h'
  | some a =>
    obtain ⟨q, w, r⟩ := a
    rw [ha] at hs
    have h' : (if 0 ≤ (if r = 1 then s.pos + 1 else s.pos - 1) ∧
        (if r = 1 then s.pos + 1 else s.pos - 1) < 6 then
      some (⟨q, if r = 1 then s.pos + 1 else s.pos - 1,
        fun o => if o = s.pos then decide (w = 1) else s.win o⟩ : WC)
    else none) = some s' := hs
    by_cases hin : 0 ≤ (if r = 1 then s.pos + 1 else s.pos - 1) ∧
        (if r = 1 then s.pos + 1 else s.pos - 1) < 6
    · rw [if_pos hin] at h'
      cases h'
      refine ⟨_, rfl, rfl, ?_, hin.1, hin.2, ?_⟩
      · show (if r = 1 then c.head + 1 else c.head - 1) =
          base + (if r = 1 then s.pos + 1 else s.pos - 1)
        by_cases hr : r = 1
        · rw [if_pos hr, if_pos hr]; omega
        · rw [if_neg hr, if_neg hr]; omega
      · intro j
        show (if j = c.head then decide (w = 1) else c.tape j) =
          winTape base T0 (fun o => if o = s.pos then decide (w = 1) else s.win o) j
        by_cases hj : j = c.head
        · rw [if_pos hj, winTape_in (by omega) (by omega),
            if_pos (show j - base = s.pos by omega)]
        · rw [if_neg hj, ht j]
          by_cases hw : base ≤ j ∧ j < base + 6
          · rw [winTape_in hw.1 hw.2, winTape_in hw.1 hw.2,
              if_neg (show j - base ≠ s.pos by omega)]
          · rw [winTape_out hw, winTape_out hw]
    · rw [if_neg hin] at h'
      cases h'

theorem wRun_sound (M : TM) (base : Int) (T0 : Int → Bool) :
    ∀ (k : Nat) (c : Conf) (s s' : WC), WRel base T0 c s → wRun M k s = some s' →
      (∃ c', M.exec k c = some c' ∧ WRel base T0 c' s') ∧
      ∀ j, 0 < j → j < k → ∃ d, M.exec j c = some d ∧ d.q ≠ M.beep := by
  intro k
  induction k with
  | zero =>
    intro c s s' h hs
    have h' : some s = some s' := hs
    cases h'
    exact ⟨⟨c, rfl, h⟩, fun j h1 h2 => absurd h2 (by omega)⟩
  | succ k ih =>
    intro c s s' h hs
    have hs' : (match wStep M s with
        | none => none
        | some s1 => if k = 0 then some s1 else if s1.st = M.beep then none
            else wRun M k s1) = some s' := hs
    cases hw : wStep M s with
    | none =>
      rw [hw] at hs'
      have h' : (none : Option WC) = some s' := hs'
      cases h'
    | some s1 =>
      rw [hw] at hs'
      have hs2 : (if k = 0 then some s1 else if s1.st = M.beep then none
          else wRun M k s1) = some s' := hs'
      obtain ⟨c1, hc1, h1⟩ := wStep_sound h hw
      have e1 : M.exec 1 c = some c1 := by
        show (M.step c).bind (M.exec 0) = some c1
        rw [hc1] <;> rfl
      by_cases hk : k = 0
      · rw [if_pos hk] at hs2
        cases hs2
        subst hk
        exact ⟨⟨c1, e1, h1⟩, fun j h1' h2' => absurd h2' (by omega)⟩
      · rw [if_neg hk] at hs2
        by_cases hb : s1.st = M.beep
        · rw [if_pos hb] at hs2
          cases hs2
        · rw [if_neg hb] at hs2
          obtain ⟨⟨c', hc', h'⟩, hmid⟩ := ih c1 s1 s' h1 hs2
          refine ⟨⟨c', ?_, h'⟩, ?_⟩
          · show (M.step c).bind (M.exec k) = some c'
            rw [hc1]
            exact hc'
          · intro j hj1 hj2
            cases j with
            | zero => exact absurd hj1 (Nat.lt_irrefl 0)
            | succ j =>
              by_cases hj : j = 0
              · subst hj
                refine ⟨c1, e1, ?_⟩
                rw [h1.q]
                exact hb
              · obtain ⟨d, hd, hdq⟩ := hmid j (by omega) (by omega)
                refine ⟨d, ?_, hdq⟩
                show (M.step c).bind (M.exec j) = some d
                rw [hc1]
                exact hd

/-! ## The compilation certificate -/

/-- Table state that enters logical state `q`. -/
def cEntry (q : Nat) : Nat := zpEntry.getD q 0

/-- Cell of its pair (0 or 1) on which the table enters logical state `q`. -/
def cSide (q : Nat) : Int := if zpSide.getD q 0 = 1 then 1 else 0

/-- Length of the gadget of logical state `q` on symbol `s`. -/
def cGlen (q s : Nat) : Nat := (zpGlen.getD q []).getD s 0

/-- Logical transition code of state `q` on symbol `s`. -/
def cCode (q s : Nat) : Nat := ((zpLogicRows[q]?).getD []).getD s 0

theorem cSide_nonneg (q : Nat) : 0 ≤ cSide q := by
  unfold cSide
  split <;> omega

theorem cSide_le (q : Nat) : cSide q ≤ 1 := by
  unfold cSide
  split <;> omega

/-- Window holding neighbours `a b`, the pair of symbol `s`, then neighbours `e f`. -/
def mkWin (a b : Bool) (s : Nat) (e f : Bool) (o : Int) : Bool :=
  if o = 0 then a else if o = 1 then b else if o = 2 then decide (2 ≤ s)
  else if o = 3 then decide (s % 2 = 1) else if o = 4 then e else f

theorem mkWin_0 (a b : Bool) (s : Nat) (e f : Bool) : mkWin a b s e f 0 = a := rfl
theorem mkWin_1 (a b : Bool) (s : Nat) (e f : Bool) : mkWin a b s e f 1 = b := rfl
theorem mkWin_2 (a b : Bool) (s : Nat) (e f : Bool) : mkWin a b s e f 2 = decide (2 ≤ s) := rfl
theorem mkWin_3 (a b : Bool) (s : Nat) (e f : Bool) :
    mkWin a b s e f 3 = decide (s % 2 = 1) := rfl
theorem mkWin_4 (a b : Bool) (s : Nat) (e f : Bool) : mkWin a b s e f 4 = e := rfl
theorem mkWin_5 (a b : Bool) (s : Nat) (e f : Bool) : mkWin a b s e f 5 = f := rfl

def winEq (u v : Int → Bool) : Bool :=
  u 0 == v 0 && u 1 == v 1 && u 2 == v 2 && u 3 == v 3 && u 4 == v 4 && u 5 == v 5

theorem winEq_spec {u v : Int → Bool} (h : winEq u v = true) (o : Int) (h0 : 0 ≤ o)
    (h6 : o < 6) : u o = v o := by
  unfold winEq at h
  simp only [Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨⟨e0, e1⟩, e2⟩, e3⟩, e4⟩, e5⟩ := h
  have : o = 0 ∨ o = 1 ∨ o = 2 ∨ o = 3 ∨ o = 4 ∨ o = 5 := by omega
  rcases this with rfl | rfl | rfl | rfl | rfl | rfl <;> assumption

/-- Start of the gadget of state `q` on symbol `s` with neighbours `a b e f`. -/
def initWC (q s : Nat) (a b e f : Bool) : WC := ⟨cEntry q, 2 + cSide q, mkWin a b s e f⟩

/-- The gadget of state `q` on symbol `s` with neighbours `a b e f` is correct. -/
def checkOne (q s : Nat) (a b e f : Bool) : Bool :=
  if cCode q s = 0 then true else
  match wRun zpMachine (cGlen q s) (initWC q s a b e f) with
  | none => false
  | some t =>
    decide (0 < cGlen q s) && t.st == cEntry ((cCode q s - 1) / 8) &&
      t.pos == (if (cCode q s - 1) / 4 % 2 = 1 then 4 else 0) + cSide ((cCode q s - 1) / 8) &&
      winEq t.win (mkWin a b ((cCode q s - 1) % 4) e f)

theorem checkOne_spec {q s : Nat} {a b e f : Bool} (h : checkOne q s a b e f = true)
    (hc : cCode q s ≠ 0) :
    ∃ t, wRun zpMachine (cGlen q s) (initWC q s a b e f) = some t ∧ 0 < cGlen q s ∧
      t.st = cEntry ((cCode q s - 1) / 8) ∧
      t.pos = (if (cCode q s - 1) / 4 % 2 = 1 then 4 else 0) + cSide ((cCode q s - 1) / 8) ∧
      ∀ o, 0 ≤ o → o < 6 → t.win o = mkWin a b ((cCode q s - 1) % 4) e f o := by
  unfold checkOne at h
  rw [if_neg hc] at h
  cases hr : wRun zpMachine (cGlen q s) (initWC q s a b e f) with
  | none =>
    rw [hr] at h
    have h' : false = true := h
    cases h'
  | some t =>
    rw [hr] at h
    have h' : (decide (0 < cGlen q s) && t.st == cEntry ((cCode q s - 1) / 8) &&
      t.pos == (if (cCode q s - 1) / 4 % 2 = 1 then 4 else 0) + cSide ((cCode q s - 1) / 8) &&
      winEq t.win (mkWin a b ((cCode q s - 1) % 4) e f)) = true := h
    simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h'
    obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := h'
    exact ⟨t, rfl, h1, h2, h3, winEq_spec h4⟩

/-! ## Kernel-checked certificate -/

def allFrom : Nat → Nat → (Nat → Bool) → Bool
  | _, 0, _ => true
  | lo, n + 1, p => p lo && allFrom (lo + 1) n p

theorem allFrom_spec (p : Nat → Bool) (n : Nat) :
    ∀ lo i, allFrom lo n p = true → lo ≤ i → i < lo + n → p i = true := by
  induction n with
  | zero => intro lo i _ h1 h2; exact absurd h2 (by omega)
  | succ n ih =>
    intro lo i h h1 h2
    have h' : (p lo && allFrom (lo + 1) n p) = true := h
    rw [Bool.and_eq_true] at h'
    by_cases hi : i = lo
    · subst hi
      exact h'.1
    · exact ih (lo + 1) i h'.2 (by omega) (by omega)

def allB (p : Bool → Bool) : Bool := p false && p true

theorem allB_spec {p : Bool → Bool} (h : allB p = true) (b : Bool) : p b = true := by
  unfold allB at h
  rw [Bool.and_eq_true] at h
  cases b
  · exact h.1
  · exact h.2

def checkQ (q : Nat) : Bool :=
  allFrom 0 4 fun s => allB fun a => allB fun b => allB fun e => allB fun f =>
    checkOne q s a b e f

theorem chk0 : allFrom 0 32 checkQ = true := by decide +kernel
theorem chk1 : allFrom 32 32 checkQ = true := by decide +kernel
theorem chk2 : allFrom 64 32 checkQ = true := by decide +kernel
theorem chk3 : allFrom 96 32 checkQ = true := by decide +kernel
theorem chk4 : allFrom 128 1 checkQ = true := by decide +kernel

theorem hchk : ∀ q s a b e f, q < 129 → s < 4 → checkOne q s a b e f = true := by
  intro q s a b e f hq hs
  have hQ : checkQ q = true := by
    by_cases h0 : q < 32
    · exact allFrom_spec _ _ 0 q chk0 (by omega) (by omega)
    · by_cases h1 : q < 64
      · exact allFrom_spec _ _ 32 q chk1 (by omega) (by omega)
      · by_cases h2 : q < 96
        · exact allFrom_spec _ _ 64 q chk2 (by omega) (by omega)
        · by_cases h3 : q < 128
          · exact allFrom_spec _ _ 96 q chk3 (by omega) (by omega)
          · exact allFrom_spec _ _ 128 q chk4 (by omega) (by omega)
  unfold checkQ at hQ
  exact allB_spec (allB_spec (allB_spec (allB_spec
    (allFrom_spec _ _ 0 s hQ (by omega) (by omega)) a) b) e) f

def beepOK : Bool :=
  allFrom 0 129 fun q => decide ((cEntry q = zpMachine.beep) ↔ (q = zpLogic.beep))

theorem beepOK_true : beepOK = true := by decide +kernel

theorem beep_entry {q : Nat} (hq : q < 129) : cEntry q = zpMachine.beep ↔ q = zpLogic.beep :=
  of_decide_eq_true (allFrom_spec _ _ 0 q beepOK_true (by omega) (by omega))

theorem cEntry_zero : cEntry 0 = 0 := by decide +kernel
theorem cSide_zero : cSide 0 = 0 := by decide +kernel
theorem zpLogic_len : zpLogic.table.length = 129 := by decide +kernel

/-! ## One logical step is one gadget -/

theorem getElem?_some_lt {α : Type} :
    ∀ (l : List α) (i : Nat) (a : α), l[i]? = some a → i < l.length
  | [], i, a, h => by simp at h
  | x :: l, 0, a, _ => by simp only [List.length_cons]; omega
  | x :: l, i + 1, a, h => by
    have h' : l[i]? = some a := by simpa using h
    have := getElem?_some_lt l i a h'
    simp only [List.length_cons]
    omega

theorem lstep_some {L : LTM} {c c' : LConf} (h : L.step c = some c') :
    ∃ cd, (∃ row, L.table[c.q]? = some row ∧ row.getD (c.tape c.head) 0 = cd) ∧ cd ≠ 0 ∧
      c' = { q := (cd - 1) / 8, tape := fun i => if i = c.head then (cd - 1) % 4 else c.tape i,
             head := if (cd - 1) / 4 % 2 = 1 then c.head + 1 else c.head - 1 } := by
  unfold LTM.step at h
  cases hr : L.table[c.q]? with
  | none =>
    rw [hr] at h
    have h' : (none : Option LConf) = some c' := h
    cases h'
  | some row =>
    rw [hr] at h
    have h' : (if row.getD (c.tape c.head) 0 = 0 then none else
        some ({ q := (row.getD (c.tape c.head) 0 - 1) / 8,
                tape := fun i => if i = c.head then (row.getD (c.tape c.head) 0 - 1) % 4
                  else c.tape i,
                head := if (row.getD (c.tape c.head) 0 - 1) / 4 % 2 = 1 then c.head + 1
                  else c.head - 1 } : LConf)) = some c' := h
    by_cases hc : row.getD (c.tape c.head) 0 = 0
    · rw [if_pos hc] at h'
      cases h'
    · rw [if_neg hc] at h'
      cases h'
      exact ⟨_, ⟨row, rfl, rfl⟩, hc, rfl⟩

/-- Logical configuration `c` is stored in host configuration `d`. -/
structure Enc (c : LConf) (d : Conf) : Prop where
  q : d.q = cEntry c.q
  head : d.head = 2 * c.head + cSide c.q
  hi : ∀ i, d.tape (2 * i) = decide (2 ≤ c.tape i)
  lo : ∀ i, d.tape (2 * i + 1) = decide (c.tape i % 2 = 1)
  sym : ∀ i, c.tape i < 4

theorem gadget {c c' : LConf} {d : Conf} (henc : Enc c d) (hstep : zpLogic.step c = some c') :
    ∃ d', zpMachine.exec (cGlen c.q (c.tape c.head)) d = some d' ∧ Enc c' d' ∧
      0 < cGlen c.q (c.tape c.head) ∧
      ∀ j, 0 < j → j < cGlen c.q (c.tape c.head) →
        ∃ e, zpMachine.exec j d = some e ∧ e.q ≠ zpMachine.beep := by
  obtain ⟨cd, ⟨row, hrow, hcd⟩, hc, rfl⟩ := lstep_some hstep
  have hq : c.q < 129 := by
    have := getElem?_some_lt _ _ _ hrow
    rw [zpLogic_len] at this
    exact this
  have hs4 : c.tape c.head < 4 := henc.sym c.head
  have hcode : cCode c.q (c.tape c.head) = cd := by
    rw [← hcd]
    exact congrArg (fun o : Option (List Nat) => (o.getD []).getD (c.tape c.head) 0) hrow
  have hk := hchk c.q (c.tape c.head) (d.tape (2 * c.head - 2)) (d.tape (2 * c.head - 1))
    (d.tape (2 * c.head + 2)) (d.tape (2 * c.head + 3)) hq hs4
  obtain ⟨t, hrun, hg, hst, hpos, hwin⟩ := checkOne_spec hk (by rw [hcode]; exact hc)
  rw [hcode] at hst hpos hwin
  have hinit : WRel (2 * c.head - 2) d.tape d (initWC c.q (c.tape c.head)
      (d.tape (2 * c.head - 2)) (d.tape (2 * c.head - 1))
      (d.tape (2 * c.head + 2)) (d.tape (2 * c.head + 3))) := by
    refine ⟨henc.q, ?_, ?_, ?_, ?_⟩
    · show d.head = 2 * c.head - 2 + (2 + cSide c.q)
      rw [henc.head]
      omega
    · show 0 ≤ 2 + cSide c.q
      have := cSide_nonneg c.q
      omega
    · show 2 + cSide c.q < 6
      have := cSide_le c.q
      omega
    · intro j
      show d.tape j = winTape (2 * c.head - 2) d.tape (mkWin (d.tape (2 * c.head - 2))
        (d.tape (2 * c.head - 1)) (c.tape c.head) (d.tape (2 * c.head + 2))
        (d.tape (2 * c.head + 3))) j
      by_cases hj : 2 * c.head - 2 ≤ j ∧ j < 2 * c.head - 2 + 6
      · rw [winTape_in hj.1 hj.2]
        have : j - (2 * c.head - 2) = 0 ∨ j - (2 * c.head - 2) = 1 ∨
            j - (2 * c.head - 2) = 2 ∨ j - (2 * c.head - 2) = 3 ∨
            j - (2 * c.head - 2) = 4 ∨ j - (2 * c.head - 2) = 5 := by omega
        rcases this with h | h | h | h | h | h
        · rw [h, mkWin_0, show j = 2 * c.head - 2 by omega]
        · rw [h, mkWin_1, show j = 2 * c.head - 1 by omega]
        · rw [h, mkWin_2, show j = 2 * c.head by omega]
          exact henc.hi c.head
        · rw [h, mkWin_3, show j = 2 * c.head + 1 by omega]
          exact henc.lo c.head
        · rw [h, mkWin_4, show j = 2 * c.head + 2 by omega]
        · rw [h, mkWin_5, show j = 2 * c.head + 3 by omega]
      · rw [winTape_out hj]
  obtain ⟨⟨d', hd', hrel⟩, hmid⟩ :=
    wRun_sound zpMachine (2 * c.head - 2) d.tape _ d _ t hinit hrun
  refine ⟨d', hd', ?_, hg, hmid⟩
  have hout : ∀ j, j ≠ 2 * c.head → j ≠ 2 * c.head + 1 → d'.tape j = d.tape j := by
    intro j h1 h2
    rw [hrel.tape j]
    by_cases hj : 2 * c.head - 2 ≤ j ∧ j < 2 * c.head - 2 + 6
    · rw [winTape_in hj.1 hj.2, hwin _ (by omega) (by omega)]
      have : j - (2 * c.head - 2) = 0 ∨ j - (2 * c.head - 2) = 1 ∨
          j - (2 * c.head - 2) = 4 ∨ j - (2 * c.head - 2) = 5 := by omega
      rcases this with h | h | h | h
      · rw [h, mkWin_0, show j = 2 * c.head - 2 by omega]
      · rw [h, mkWin_1, show j = 2 * c.head - 1 by omega]
      · rw [h, mkWin_4, show j = 2 * c.head + 2 by omega]
      · rw [h, mkWin_5, show j = 2 * c.head + 3 by omega]
    · rw [winTape_out hj]
  have hp0 : d'.tape (2 * c.head) = decide (2 ≤ (cd - 1) % 4) := by
    rw [hrel.tape, winTape_in (by omega) (by omega), hwin _ (by omega) (by omega),
      show 2 * c.head - (2 * c.head - 2) = 2 by omega, mkWin_2]
  have hp1 : d'.tape (2 * c.head + 1) = decide ((cd - 1) % 4 % 2 = 1) := by
    rw [hrel.tape, winTape_in (by omega) (by omega), hwin _ (by omega) (by omega),
      show 2 * c.head + 1 - (2 * c.head - 2) = 3 by omega, mkWin_3]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · show d'.q = cEntry ((cd - 1) / 8)
    rw [hrel.q]
    exact hst
  · show d'.head = 2 * (if (cd - 1) / 4 % 2 = 1 then c.head + 1 else c.head - 1) +
      cSide ((cd - 1) / 8)
    rw [hrel.head, hpos]
    by_cases hr : (cd - 1) / 4 % 2 = 1
    · rw [if_pos hr, if_pos hr]
      omega
    · rw [if_neg hr, if_neg hr]
      omega
  · intro i
    show d'.tape (2 * i) = decide (2 ≤ (if i = c.head then (cd - 1) % 4 else c.tape i))
    by_cases hi : i = c.head
    · rw [if_pos hi, hi]
      exact hp0
    · rw [if_neg hi, hout _ (by omega) (by omega)]
      exact henc.hi i
  · intro i
    show d'.tape (2 * i + 1) = decide ((if i = c.head then (cd - 1) % 4 else c.tape i) % 2 = 1)
    by_cases hi : i = c.head
    · rw [if_pos hi, hi]
      exact hp1
    · rw [if_neg hi, hout _ (by omega) (by omega)]
      exact henc.lo i
  · intro i
    show (if i = c.head then (cd - 1) % 4 else c.tape i) < 4
    by_cases hi : i = c.head
    · rw [if_pos hi]
      exact Nat.mod_lt _ (by decide)
    · rw [if_neg hi]
      exact henc.sym i

/-! ## The whole run -/

def glenO : Option LConf → Nat
  | some c => cGlen c.q (c.tape c.head)
  | none => 1

/-- Length of the gadget run for logical step `k`. -/
def glenAt (k : Nat) : Nat := glenO (zpLogic.conf k)

/-- Host time of logical step `k`. -/
def htime : Nat → Nat
  | 0 => 0
  | k + 1 => htime k + glenAt k

theorem glenAt_eq {k : Nat} {c : LConf} (hc : zpLogic.conf k = some c) :
    glenAt k = cGlen c.q (c.tape c.head) :=
  congrArg glenO hc

theorem lstep_of_conf {L : LTM} {k : Nat} {c c' : LConf} (hc : L.conf k = some c)
    (hc' : L.conf (k + 1) = some c') : L.step c = some c' := by
  have h : (L.conf k).bind L.step = some c' := hc'
  rw [hc] at h
  exact h

theorem sim1 : ∀ k c, zpLogic.conf k = some c →
    ∃ d, zpMachine.conf (htime k) = some d ∧ Enc c d := by
  intro k
  induction k with
  | zero =>
    intro c hc
    have hc' : some (⟨0, fun _ => 0, 0⟩ : LConf) = some c := hc
    cases hc'
    refine ⟨⟨0, fun _ => false, 0⟩, rfl, ?_⟩
    refine ⟨?_, ?_, fun _ => rfl, fun _ => rfl, fun _ => ?_⟩
    · show 0 = cEntry 0
      rw [cEntry_zero]
    · show (0 : Int) = 2 * 0 + cSide 0
      rw [cSide_zero] <;> decide
    · show (0 : Nat) < 4
      decide
  | succ k ih =>
    intro c' hc'
    cases hk : zpLogic.conf k with
    | none =>
      have h : (zpLogic.conf k).bind zpLogic.step = some c' := hc'
      rw [hk] at h
      have h2 : (none : Option LConf) = some c' := h
      cases h2
    | some c =>
      have hs := lstep_of_conf hk hc'
      obtain ⟨d, hd, he⟩ := ih c hk
      obtain ⟨d', hd', he', -, -⟩ := gadget he hs
      refine ⟨d', ?_, he'⟩
      show zpMachine.conf (htime k + glenAt k) = some d'
      rw [glenAt_eq hk, TM.conf_add, hd]
      exact hd'

section
variable (hT : ∀ k, ∃ c, zpLogic.conf k = some c)
include hT

theorem glenAt_pos (k : Nat) : 0 < glenAt k := by
  obtain ⟨c, hc⟩ := hT k
  obtain ⟨c', hc'⟩ := hT (k + 1)
  obtain ⟨d, -, he⟩ := sim1 k c hc
  obtain ⟨-, -, -, hg, -⟩ := gadget he (lstep_of_conf hc hc')
  rw [glenAt_eq hc]
  exact hg

theorem htime_succ (k : Nat) : htime k < htime (k + 1) := by
  have := glenAt_pos hT k
  show htime k < htime k + glenAt k
  omega

theorem htime_le (a b : Nat) (hab : a ≤ b) : htime a ≤ htime b := by
  induction b with
  | zero =>
    have : a = 0 := by omega
    subst this
    exact Nat.le_refl _
  | succ b ih =>
    by_cases h : a = b + 1
    · subst h
      exact Nat.le_refl _
    · have h1 := ih (by omega)
      have h2 := htime_succ hT b
      omega

theorem htime_strict {a b : Nat} (hab : a < b) : htime a < htime b := by
  cases b with
  | zero => exact absurd hab (Nat.not_lt_zero a)
  | succ b =>
    have h1 := htime_le hT a b (by omega)
    have h2 := htime_succ hT b
    omega

theorem lq_lt {k : Nat} {c : LConf} (hc : zpLogic.conf k = some c) : c.q < 129 := by
  obtain ⟨c', hc'⟩ := hT (k + 1)
  obtain ⟨cd, ⟨row, hrow, -⟩, -, -⟩ := lstep_some (lstep_of_conf hc hc')
  have := getElem?_some_lt _ _ _ hrow
  rw [zpLogic_len] at this
  exact this

theorem between (k j : Nat) (hj0 : 0 < j) (hj : j < glenAt k) (e : Conf)
    (he : zpMachine.conf (htime k + j) = some e) : e.q ≠ zpMachine.beep := by
  obtain ⟨c, hc⟩ := hT k
  obtain ⟨c', hc'⟩ := hT (k + 1)
  obtain ⟨d, hd, henc⟩ := sim1 k c hc
  obtain ⟨-, -, -, -, hmid⟩ := gadget henc (lstep_of_conf hc hc')
  rw [glenAt_eq hc] at hj
  obtain ⟨e', he', hq⟩ := hmid j hj0 hj
  rw [TM.conf_add, hd] at he
  have he2 : zpMachine.exec j d = some e := he
  rw [he'] at he2
  cases he2
  exact hq

end

theorem beeps_iff (S : LMacroSim zpLogic) (n : Nat) :
    (∃ k, htime (S.time n) ≤ k ∧ k < htime (S.time (n + 1)) ∧
      ∃ d, zpMachine.conf k = some d ∧ d.q = zpMachine.beep) ↔
      ¬ Correct (absState n).1 (absState n).2 := by
  rw [← S.beeps n]
  constructor
  · rintro ⟨k, h1, h2, d, hd, hq⟩
    obtain ⟨m, hm1, hm2, hm3⟩ := time_interval htime (htime_succ S.total) (S.time n) k h1
    have hm4 : m < S.time (n + 1) := by
      by_cases hle : S.time (n + 1) ≤ m
      · have := htime_le S.total _ _ hle
        omega
      · omega
    obtain ⟨c, hc⟩ := S.total m
    refine ⟨m, hm1, hm4, c, hc, ?_⟩
    obtain ⟨d0, hd0, henc⟩ := sim1 m c hc
    by_cases hkm : k = htime m
    · rw [hkm, hd0] at hd
      cases hd
      rw [henc.q] at hq
      exact (beep_entry (lq_lt S.total hc)).1 hq
    · exfalso
      have hgl : htime (m + 1) = htime m + glenAt m := rfl
      have hk' : k = htime m + (k - htime m) := by omega
      rw [hk'] at hd
      exact between S.total m (k - htime m) (by omega) (by omega) d hd hq
  · rintro ⟨m, hm1, hm2, c, hc, hq⟩
    obtain ⟨d, hd, henc⟩ := sim1 m c hc
    refine ⟨htime m, htime_le S.total _ _ hm1, htime_strict S.total hm2, d, hd, ?_⟩
    rw [henc.q]
    exact (beep_entry (lq_lt S.total hc)).2 hq

/-- A macro simulation by the logical machine gives one by the table. -/
def macroSim_of_logic (S : LMacroSim zpLogic) : MacroSim zpMachine where
  time n := htime (S.time n)
  mono n := htime_strict S.total (S.mono n)
  beeps n := beeps_iff S n

theorem zp_macroSim : Nonempty (MacroSim zpMachine) :=
  zpLogic_macroSim.elim fun S => ⟨macroSim_of_logic S⟩

theorem zp_quasihalts_iff_abstract : Quasihalts zpMachine ↔ AbstractQuasihalts :=
  zp_macroSim.elim quasihalts_iff_of_macroSim

end ZP
