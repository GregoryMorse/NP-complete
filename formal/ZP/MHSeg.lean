module

public import ZP.MHInterp

@[expose] public section

/-!
# Multihead run: interpreter segments without guest cells (generated)

Generated by `formal/scripts/gen_mhinterp.py`. The tape of a multihead run is

    Q  0^g  0  c  H  M_g W ...        (c = the scanned symbol, `0` = blank, H = `1` = M)

so the zp2 segments of `ZP/Interp.lean` that sweep guest cells `Lw`/`Rw` (the count-down write, the
halting peeks, the write-and-move) are redone here for `Lw = Rw = []`; `segB`, `segC` and the token
segments of `ZP/MHInterp.lean` are unchanged. All statements are about `mhBase`.
-/

namespace ZP.MH

open ZP


/-- Count-down: `BK2` on a bit `ch`, to `TW` at the right end of `Q`. -/
theorem segA0 (Qw Wr : List Nat) (g ch : Nat) (hch : ch ∈ bits) (hQ : Bits Qw) (hWr : Sym4 Wr) :
    mhBase.Reach (hd Q.BK2 (Qw ++ List.replicate g 0 ++ [0, ch])
        ([1] ++ Wr))
      (hd Q.TW (Qw)
        (List.replicate g 0 ++ [0, (cdn ch), 1] ++ Wr)) := by
  have hv : Valid [bits, ALL, ALL] [Qw, List.replicate g 0, Wr] := (Valid.cons hQ (Valid.cons (zeros4 g) (Valid.cons hWr (Valid.nil _))))
  rcases mem_bits hch with rfl | rfl
  · exact checkTT (env := [Qw, List.replicate g 0, Wr]) (E := []) (k := 3) hv trivial
            (ls := [.blk 0 .id, .blk 1 (.const 0), .sym 0, .sym 2]) (rs := [.sym 1, .blk 2 .id])
            (ls' := [.blk 0 .id]) (rs' := [.blk 1 (.const 0), .sym 0, .sym 0, .sym 1, .blk 2 .id])
            (by decide +kernel) (by wsimp) (by wsimp) (by wsimp) (by simp [cdn, dR, Item.den, List.getD, map_id_app, map_const_rep, Fn.app, rep_rep])
  · exact checkTT (env := [Qw, List.replicate g 0, Wr]) (E := []) (k := 3) hv trivial
            (ls := [.blk 0 .id, .blk 1 (.const 0), .sym 0, .sym 3]) (rs := [.sym 1, .blk 2 .id])
            (ls' := [.blk 0 .id]) (rs' := [.blk 1 (.const 0), .sym 0, .sym 2, .sym 1, .blk 2 .id])
            (by decide +kernel) (by wsimp) (by wsimp) (by wsimp) (by simp [cdn, dR, Item.den, List.getD, map_id_app, map_const_rep, Fn.app, rep_rep])

/-- Time-out: `EXH` on the blank `c`, cleanup, result 0. -/
theorem segExh0 (Qw W : List Nat) (g r : Nat) (hr : r ∈ bits) (hQ : Bits Qw) (hW : Sym4 W) :
    mhBase.Reach (hd Q.EXH (Qw ++ [r] ++ List.replicate g 0 ++ [0, 0])
        ([1, 1] ++ W))
      (hdR Q.DP10 ([1])
        (W)) := by
  have hv : Valid [bits, ALL, ALL] [Qw, List.replicate g 0, W] := (Valid.cons hQ (Valid.cons (zeros4 g) (Valid.cons hW (Valid.nil _))))
  rcases mem_bits hr with rfl | rfl
  · exact checkTF (env := [Qw, List.replicate g 0, W]) (E := []) (k := 15) hv trivial
            (ls := [.blk 0 .id, .sym 2, .blk 1 (.const 0), .sym 0, .sym 0]) (rs := [.sym 1, .sym 1, .blk 2 .id])
            (ls' := [.sym 1]) (rs' := [.blk 2 .id])
            (by decide +kernel) (by wsimp) (by wsimp) (by wsimp) (by wsimp)
  · exact checkTF (env := [Qw, List.replicate g 0, W]) (E := []) (k := 15) hv trivial
            (ls := [.blk 0 .id, .sym 3, .blk 1 (.const 0), .sym 0, .sym 0]) (rs := [.sym 1, .sym 1, .blk 2 .id])
            (ls' := [.sym 1]) (rs' := [.blk 2 .id])
            (by decide +kernel) (by wsimp) (by wsimp) (by wsimp) (by wsimp)

/-- Halting peek `w d 0`: outcome `w`. -/
theorem segHalt (Qw W : List Nat) (g r0 r1 : Nat) (h0 : r0 ∈ bits) (h1 : r1 ∈ bits) (hQ : Bits Qw) (hW : Sym4 W) :
    mhBase.Reach (hd Q.FBACK (Qw ++ [2, r1, r0] ++ List.replicate g 0 ++ [0, 0])
        ([1, 1] ++ W))
      (hdR (dpOf r0) ([1])
        (W)) := by
  have hv : Valid [bits, ALL, ALL] [Qw, List.replicate g 0, W] := (Valid.cons hQ (Valid.cons (zeros4 g) (Valid.cons hW (Valid.nil _))))
  rcases mem_bits h0 with rfl | rfl <;> rcases mem_bits h1 with rfl | rfl
  · exact checkTF (env := [Qw, List.replicate g 0, W]) (E := []) (k := 29) hv trivial
            (ls := [.blk 0 .id, .sym 2, .sym 2, .sym 2, .blk 1 (.const 0), .sym 0, .sym 0]) (rs := [.sym 1, .sym 1, .blk 2 .id])
            (ls' := [.sym 1]) (rs' := [.blk 2 .id])
            (by decide +kernel) (by wsimp) (by wsimp) (by wsimp) (by wsimp)
  · exact checkTF (env := [Qw, List.replicate g 0, W]) (E := []) (k := 29) hv trivial
            (ls := [.blk 0 .id, .sym 2, .sym 3, .sym 2, .blk 1 (.const 0), .sym 0, .sym 0]) (rs := [.sym 1, .sym 1, .blk 2 .id])
            (ls' := [.sym 1]) (rs' := [.blk 2 .id])
            (by decide +kernel) (by wsimp) (by wsimp) (by wsimp) (by wsimp)
  · exact checkTF (env := [Qw, List.replicate g 0, W]) (E := []) (k := 29) hv trivial
            (ls := [.blk 0 .id, .sym 2, .sym 2, .sym 3, .blk 1 (.const 0), .sym 0, .sym 0]) (rs := [.sym 1, .sym 1, .blk 2 .id])
            (ls' := [.sym 1]) (rs' := [.blk 2 .id])
            (by decide +kernel) (by wsimp) (by wsimp) (by wsimp) (by wsimp)
  · exact checkTF (env := [Qw, List.replicate g 0, W]) (E := []) (k := 29) hv trivial
            (ls := [.blk 0 .id, .sym 2, .sym 3, .sym 3, .blk 1 (.const 0), .sym 0, .sym 0]) (rs := [.sym 1, .sym 1, .blk 2 .id])
            (ls' := [.sym 1]) (rs' := [.blk 2 .id])
            (by decide +kernel) (by wsimp) (by wsimp) (by wsimp) (by wsimp)

/-- Single-entry code `[false]`: halt with outcome 0. -/
theorem segShort1 (W : List Nat) (g : Nat) (hW : Sym4 W) :
    mhBase.Reach (hd Q.FBACK ([2] ++ List.replicate g 0 ++ [0, 0])
        ([1, 1] ++ W))
      (hdR Q.DP10 ([1])
        (W)) := by
  have hv : Valid [bits, ALL, ALL] [[], List.replicate g 0, W] := (Valid.cons Bits.nil (Valid.cons (zeros4 g) (Valid.cons hW (Valid.nil _))))
  exact checkTF (env := [[], List.replicate g 0, W]) (E := []) (k := 21) hv trivial
        (ls := [.sym 2, .blk 1 (.const 0), .sym 0, .sym 0]) (rs := [.sym 1, .sym 1, .blk 2 .id])
        (ls' := [.sym 1]) (rs' := [.blk 2 .id])
        (by decide +kernel) (by wsimp) (by wsimp) (by wsimp) (by wsimp)

