@[expose] public section

/-!
# Multihead act: segments (generated)

Generated by `formal/scripts/gen_mhact.py`; do not edit. The tape of an act is

    Qc 0^g 0 c H  Y  B  S                  (Y = `M_g ... end of fuel`, no blank; `S` = the storage)

with `S = P B T`, `B` the marker of the current head. `act*` segments go from `G2 w d` on the first
cell of `Y` (the head is right of `H`) to `RR` right of the new marker (or `KB` for a clamped move);
`carry*` segments finish: they read the scanned symbol and write it into `c`, ending in `RTW` on the
last cell of `Qc`. All statements are about `mhBase`; they transfer to every machine that extends it.
-/

namespace ZP.MH

open ZP


/-- Move right on a bit `b`: the marker swaps with it; `RR` right of the new marker. -/
theorem actMR (Qc Y P T : List Nat) (g b : Nat) (hb : b ∈ bits) (hQ : Bits Qc) (hY : NoB Y) (hP : NoB P) (hT : Sym4 T) :
    mhBase.Reach (hdR QMH.G211 (Qc ++ List.replicate g 0 ++ [0, 0, 1])
        (Y ++ [0] ++ P ++ [0, b] ++ T))
      (hdR QMH.RR (Qc ++ List.replicate g 0 ++ [0, 0, 1] ++ Y ++ [0] ++ P ++ [b, 0])
        (T)) := by
  have hv : Valid [bits, ALL, NB, NB, ALL] [Qc, List.replicate g 0, Y, P, T] := (Valid.cons hQ (Valid.cons (zeros4 g) (Valid.cons hY (Valid.cons hP (Valid.cons hT (Valid.nil _))))))
  rcases mem_bits hb with rfl | rfl
  · exact checkFF (env := [Qc, List.replicate g 0, Y, P, T]) (E := []) (k := 7) hv trivial
            (ls := [.blk 0 .id, .blk 1 (.const 0), .sym 0, .sym 0, .sym 1]) (rs := [.blk 2 .id, .sym 0, .blk 3 .id, .sym 0, .sym 2, .blk 4 .id])
            (ls' := [.blk 0 .id, .blk 1 (.const 0), .sym 0, .sym 0, .sym 1, .blk 2 .id, .sym 0, .blk 3 .id, .sym 2, .sym 0]) (rs' := [.blk 4 .id])
            (by decide +kernel) (by wsimp) (by wsimp) (by wsimp) (by wsimp)
  · exact checkFF (env := [Qc, List.replicate g 0, Y, P, T]) (E := []) (k := 7) hv trivial
            (ls := [.blk 0 .id, .blk 1 (.const 0), .sym 0, .sym 0, .sym 1]) (rs := [.blk 2 .id, .sym 0, .blk 3 .id, .sym 0, .sym 3, .blk 4 .id])
            (ls' := [.blk 0 .id, .blk 1 (.const 0), .sym 0, .sym 0, .sym 1, .blk 2 .id, .sym 0, .blk 3 .id, .sym 3, .sym 0]) (rs' := [.blk 4 .id])
            (by decide +kernel) (by wsimp) (by wsimp) (by wsimp) (by wsimp)

