theorem vRejC (j : List Nat) (s : List Nat) (Cp : List Nat) (Z : List Nat) (D : List Nat) (E : List Nat) (c : Nat) (hj : Bits j) (hs : Bits s) (hCp : Bits Cp) (hZ : ∀ a ∈ Z, a ∈ Z2) (hD : ∀ a ∈ D, a ∈ T3) (hE : ∀ a ∈ E, a ∈ Z2) (hc : c ∈ bits) :
