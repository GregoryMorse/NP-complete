theorem vRejE (j : List Nat) (s : List Nat) (Z : List Nat) (D : List Nat) (E : List Nat) (hj : Bits j) (hs : Bits s) (hZ : ∀ a ∈ Z, a ∈ Z2) (hD : ∀ a ∈ D, a ∈ T3) (hE : ∀ a ∈ E, a ∈ Z2) :
