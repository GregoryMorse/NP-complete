/-!
# Advertised statement

`ZP.zpMachine` is the literal 2-symbol table `machines/zp_native.txt` (278 states,
`ZP/Table.lean`, generated from the build output). `ZP.Quasihalts` and `ZP.Sentence` are defined in
`ZP/Defs.lean`. Those two files are the whole trusted surface, in core Lean only.

The claim: run from the blank tape, the machine is in its beep state only finitely
often iff some candidate guest program `J` decides the language `L` correctly on
every instance within the clock `(|s|+2)^(|J|+1) - 1`.

The further equivalence `ZP.Sentence ↔ P = NP` is proved in the Lean development
(`ZP.Cx.sentence_iff_PeqNP`; construction in `docs/native.md`) and is **not** part of this statement.
-/

theorem ZP.zp_quasihalts_iff_sentence : ZP.Quasihalts ZP.zpMachine ↔ ZP.Sentence := by
  sorry

theorem ZP.zpp_quasihalts_iff_sentence : ZP.Quasihalts ZP.zppMachine ↔ ZP.SentencePP := by
  sorry

theorem ZP.zps_quasihalts_iff_sentence : ZP.Quasihalts ZP.zpsMachine ↔ ZP.SentencePS := by
  sorry

theorem ZP.zfac_quasihalts_iff_sentence : ZP.Quasihalts ZP.zfacMachine ↔ ZP.SentenceF := by
  sorry

theorem ZP.zdl_quasihalts_iff_sentence : ZP.Quasihalts ZP.zdlMachine ↔ ZP.SentenceD := by
  sorry

theorem ZP.zgi_quasihalts_iff_sentence : ZP.Quasihalts ZP.zgiMachine ↔ ZP.SentenceG := by
  sorry

/-- Z_NTT: `primeN n` is the least prime `1 + n i`, `i ≥ 1` (it exists for every `n ≥ 1`; proved in the solution). -/
theorem ZP.zntt_quasihalts_iff_sentence :
    ZP.Quasihalts ZP.znttMachine ↔ ZP.SentenceN ZP.primeN := by
  sorry

/-- Z_MUL: the guest also has a queue of stacks; the output must be a pair numeral `1 b₁ … 1 bₖ`
whose value is `x y`, for the first two numbers `x, y` of the instance. -/
theorem ZP.zmul_quasihalts_iff_sentence : ZP.Quasihalts ZP.zmulMachine ↔ ZP.SentenceMul := by
  sorry

/-- Z_coNP: the guest is `zp2` with nondeterministic choices at fresh cells; `J` is a verifier for the complement
of `L`. -/
theorem ZP.zconp_quasihalts_iff_sentence : ZP.Quasihalts ZP.zconpMachine ↔ ZP.SentenceConp := by
  sorry

/-- The 19-state twin-prime beeper: it quasihalts iff there are finitely many twin primes. -/
theorem ZP.twin_quasihalts_iff : ZP.Quasihalts ZP.twinMachine ↔ ¬ ZP.TwinPrimes := by
  sorry

/-- Z_BPP: promise-P = promise-BPP in the self-padded form. `capp s` is YES / NO / outside the promise
(`4 acc ≥ 3 N`, `4 rej ≥ 3 N`, neither); a candidate is judged only on instances inside the promise. -/
theorem ZP.zbpp_quasihalts_iff_sentence : ZP.Quasihalts ZP.zbppMachine ↔ ZP.SentenceBPP := by
  sorry

/-- Z_PPOLY: NP in P/poly form. A degree `K` fixes the budget `(n+2)^(|K|+1) - 1`; an advice program `a` is
charged `|a|` steps, and `K` is good on length `n` if some `a` decides `L` on all strings of length `n` within it. -/
theorem ZP.zppoly_quasihalts_iff_sentence : ZP.Quasihalts ZP.zppolyMachine ↔ ZP.SentencePoly := by
  sorry

/-- Z_MATMUL: the matrix-product machine. An instance `s = 1^m 0 w` holds an `m x m` matrix `B` and `A`, row-major,
in `w`; a candidate program `J` is judged on whether, within the clock `(|s|+2) 2^|J| - 1`, it outputs the
GF(2) product `A B` (zero-padded to its length). -/
theorem ZP.zmm_quasihalts_iff_sentence : ZP.Quasihalts ZP.zmmMachine ↔ ZP.SentenceMM := by
  sorry

/-- Z_LP: the multihead machine. A candidate `J` is a multihead automaton (heads moved by the code, `|J| + 1` of
them) judged on whether, within the clock `(|s|+2)^(|J|+1) - 1`, its run on `s` agrees with `L_P`, the
program `s` run on its own text. -/
theorem ZP.zlp_quasihalts_iff_sentence : ZP.Quasihalts ZP.zlpMachine ↔ ZP.SentenceLP := by
  sorry

/-- Z_LNL: the nondeterministic multihead machine. `L_NL` is the set of `s` for which some certificate of length
`|s|+1` makes the one-way program `s` accept within `|s|+1` steps; a candidate `J` is a multihead automaton judged on
whether, within the clock `(|s|+2)^(|J|+1) - 1`, its run on `s` agrees with `L_NL`. -/
theorem ZP.zlnl_quasihalts_iff_sentence : ZP.Quasihalts ZP.zlnlMachine ↔ ZP.SentenceLNL := by
  sorry
